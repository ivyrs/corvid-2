---
import { analyticsSource as source } from "~/lib/analytics";
import { e } from "~/lib/utils";
---

{
  () => {
    switch (source()) {
      case "goat":
        return (
          <script
            data-goatcounter={e.GOAT_HOST}
            async
            src="//gc.zgo.at/count.js"
          />
        );
      case "umami":
        return (
          <script
            defer
            src={`${e.UMAMI_HOST}/script.js`}
            data-website-id={e.UMAMI_CODE}
          />
        );

      default:
        break;
    }
  }
}
