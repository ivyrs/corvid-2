---
import Convert from "ansi-to-html";

interface Props {
	raw: string;
	name?: string;
	open?: boolean;
}

const { raw, name, open = false } = Astro.props;

// ansi-to-html only understands SGR (colour) codes, not cursor movement —
// hyfetch uses `ESC[<n>G` (cursor horizontal absolute) to align info values
// into a column, so expand those into literal spaces before conversion or
// they get dropped to a stray "G" in the output.
function expandCursorColumns(input: string): string {
	return input
		.split("\n")
		.map((line) => {
			let visibleLen = 0;
			let result = "";
			let i = 0;
			while (i < line.length) {
				const escMatch = line.slice(i).match(/^\x1b\[[0-9;]*[A-Za-z]/);
				if (escMatch) {
					const seq = escMatch[0];
					const colMatch = seq.match(/^\x1b\[(\d*)G$/);
					if (colMatch) {
						const targetCol = colMatch[1] ? parseInt(colMatch[1], 10) : 1;
						const pad = targetCol - 1 - visibleLen;
						if (pad > 0) {
							result += " ".repeat(pad);
							visibleLen += pad;
						}
					} else {
						result += seq;
					}
					i += seq.length;
					continue;
				}
				result += line[i];
				visibleLen += 1;
				i += 1;
			}
			return result;
		})
		.join("\n");
}

const convert = new Convert({ escapeXML: true });
const html = convert.toHtml(expandCursorColumns(raw.replace(/\s+$/, "")));
---

<details class="my-2" open={open}>
	{name && <summary class="cursor-pointer select-none link">{name}</summary>}
	<pre
		class="neofetch overflow-x-auto rounded-md p-4 text-sm leading-tight my-2 bg-yin text-yang"
		set:html={html}
	/>
</details>
