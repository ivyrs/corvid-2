---
import Icon from "~/components/ui/Icon.astro";

interface Props {
	user: string;
}

const { user } = Astro.props;
---

<div class="flex items-center gap-2 text-base my-2" id="now-playing" data-user={user}>
	<span id="now-playing-text" class="">loading...</span>
</div>

<script>
	async function fetchStatus(user: string, el: HTMLElement) {
		try {
			const playingRes = await fetch(`https://api.listenbrainz.org/1/user/${user}/playing-now`);
			const playingData = await playingRes.json();
			const nowListen = playingData.payload?.listens?.[0];

			if (nowListen) {
				const { track_name, artist_name } = nowListen.track_metadata;
				el.textContent = `listening to ${track_name} by ${artist_name}`;
				return;
			}

			const recentRes = await fetch(`https://api.listenbrainz.org/1/user/${user}/listens?count=1`);
			const recentData = await recentRes.json();
			const lastListen = recentData.payload?.listens?.[0];

			if (lastListen) {
				const { track_name, artist_name } = lastListen.track_metadata;
				el.textContent = `last listened to ${track_name} by ${artist_name}`;
			} else {
				el.textContent = "no recent listens";
			}
		} catch {
			el.textContent = "couldn't load listening status";
		}
	}

	const container = document.getElementById("now-playing");
	const textEl = document.getElementById("now-playing-text");
	const user = container?.dataset.user;

	if (container && textEl && user) {
		fetchStatus(user, textEl);
		setInterval(() => fetchStatus(user, textEl), 60_000);
	}
</script>
