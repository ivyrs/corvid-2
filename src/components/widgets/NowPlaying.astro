---
interface Props {
	user?: string;
}

const { user = "ivyt" } = Astro.props;
---

<div
	class="text-base my-2"
	id="now-playing"
	data-user={user}
>
	<span id="listening-prefix" class="text-yin-7 dark:text-yin-3">
		loading...
	</span>
	<span id="listening-track"></span>

	<br />

	<span id="listening-by" class="text-yin-7 dark:text-yin-3"></span>
	<span id="listening-artist"></span>
</div>

<script>
	async function fetchStatus(
		user: string,
		prefix: HTMLElement,
		track: HTMLElement,
		by: HTMLElement,
		artist: HTMLElement,
	) {
		try {
			const playingRes = await fetch(
				`https://api.listenbrainz.org/1/user/${user}/playing-now`
			);
			const playingData = await playingRes.json();
			const nowListen = playingData.payload?.listens?.[0];

			if (nowListen) {
				const { track_name, artist_name } = nowListen.track_metadata;

				prefix.textContent = "listening to ";
				track.textContent = track_name;
				by.textContent = "by ";
				artist.textContent = artist_name;

				return;
			}

			const recentRes = await fetch(
				`https://api.listenbrainz.org/1/user/${user}/listens?count=1`
			);
			const recentData = await recentRes.json();
			const lastListen = recentData.payload?.listens?.[0];

			if (lastListen) {
				const { track_name, artist_name } = lastListen.track_metadata;

				prefix.textContent = "last listened to ";
				track.textContent = track_name;
				by.textContent = "by ";
				artist.textContent = artist_name;
			} else {
				prefix.textContent = "no recent listens";
				track.textContent = "";
				by.textContent = "";
				artist.textContent = "";
			}
		} catch {
			prefix.textContent = "couldn't load listening status";
			track.textContent = "";
			by.textContent = "";
			artist.textContent = "";
		}
	}

	const container = document.getElementById("now-playing");
	const prefix = document.getElementById("listening-prefix");
	const track = document.getElementById("listening-track");
	const by = document.getElementById("listening-by");
	const artist = document.getElementById("listening-artist");
	const user = container?.dataset.user;

	if (container && prefix && track && by && artist && user) {
		const update = () =>
			fetchStatus(user, prefix, track, by, artist);

		update();
		setInterval(update, 60_000);
	}
</script>
