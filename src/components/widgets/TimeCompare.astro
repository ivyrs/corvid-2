---
interface Props {
	timezone?: string;
}

const { timezone = "Europe/London" } = Astro.props;
---

<div
	class="not-prose flex items-center gap-2 text-base my-2"
	id="ivy-time"
	data-timezone={timezone}
>
	<span id="ivy-time-text" class="text-yin-7 dark:text-yin-3">
		loading...
	</span>
</div>

<script>
	function formatTime(tz: string) {
		return new Date().toLocaleTimeString("en-GB", {
			timeZone: tz,
			hour: "2-digit",
			minute: "2-digit",
		});
	}

	function isBirthday(tz: string): boolean {
		const parts = new Intl.DateTimeFormat("en-GB", {
			timeZone: tz,
			month: "2-digit",
			day: "2-digit",
		}).formatToParts(new Date());

		const month = parts.find((p) => p.type === "month")?.value;
		const day = parts.find((p) => p.type === "day")?.value;

		return month === "10" && day === "16";
	}

	function tick(timezone: string, text: HTMLElement) {
		const time = formatTime(timezone);
		const birthday = isBirthday(timezone) ? " 🎂 it's my birthday!" : "";

		text.textContent = `time: ${time} (${timezone})${birthday}`;
	}

	const container = document.getElementById("ivy-time");
	const text = document.getElementById("ivy-time-text");
	const timezone = container?.dataset.timezone;

	if (container && text && timezone) {
		tick(timezone, text);
		setInterval(() => tick(timezone, text), 30_000);
	}
</script>
