---
import { Image } from "astro:assets";
import buttons from "~/data/buttons.json";
---

<div class="flex flex-wrap gap-0.5">
	{
		buttons.map((i) => {
			return (
				<a href={"https://" + i.link} target="_blank">
					<Image
						style={"image-rendering: pixelated;"}
						loading={"eager"}
						src={i.image}
						width={88}
						height={31}
						alt={i.alt || i.link}
					/>
				</a>
			);
		})
	}
</div>
