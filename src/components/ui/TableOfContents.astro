---
import Box from "./Box.astro";
import type { Theme } from "~/lib/sectionThemes";

import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
	xstyle?: string;
	theme?: Theme;
}

const {headings, xstyle, theme} = Astro.props;

const head = headings.filter((h) => h.depth >= 3 && h.slug != "footnote-label");
---

<Box title="table of contents" xstyle={xstyle + " my-2"} theme={theme}>
	<ul>
	{ head.length > 1 && head.map((i) => {
		return <li><a class="" href={'#' + i.slug}>{i.text}</a></li>	
	})
	}
	</ul>
</Box>
