---
import { getCollection } from "astro:content";
import LinkRow from "~/components/ui/LinkRow.astro";
import Link from "~/components/ui/Link.astro";

interface Props {
	ids: string[];
}

const { ids } = Astro.props;

const entries = await getCollection("pages", (i) => ids.includes(i.id));
const sorted = ids
	.map((id) => entries.find((i) => i.id === id))
	.filter((i) => i !== undefined);
---

{
	sorted.length > 0 && (
		<div class="mt-4 pt-2 w-fit min-w-128 border-t-1 border-dashed border-t-red-7 dark:border-t-pink-4">
			<p class="text-yin-6 dark:text-yin-4 mb-1">related pages</p>
			<LinkRow>
				{sorted.map((i) => (
					<Link href={`/${i.id}`} icon={i.data.icon}>
						{i.data.title || "/" + i.id}
					</Link>
				))}
			</LinkRow>
		</div>
	)
}
