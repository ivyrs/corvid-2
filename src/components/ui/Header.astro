---
/** biome-ignore-all lint/correctness/noUnusedImports: eat my ass-tro */

import { site } from "../../site.config";
---

<header class="w-fit mb-4 pr-2 bg-yin-2 dark:bg-yin-8 md:flex md:gap-2">
  <a href="/" class="block w-fit">
    <h1 class="bg-pink-4 text-yin py-1 px-2">{`${site.title}`}</h1>
  </a>
  <nav class="flex flex-row gap-4 pt-1">
    {
      site.nav.map((i) => {
        return <a class="" href={i.href}>{i.name || `.${i.href}`}</a>;
      })
    }
  </nav>
</header>
