---
import Date from "~/components/ui/Date.astro";
import Breadcrumbs from "~/components/ui/Breadcrumbs.astro";

interface Props {
    title?: string;
    desc?: string;
    date?: Date | string;
    icon?: string;
}

const { title, desc, date, icon } = Astro.props;
---

<div class="mb-2 flex flex-col">
    <h2 class="text-2xl font-bold flex items-center gap-2">
        {icon && <i class={icon} />}
        <Breadcrumbs title={title} />
    </h2>

    {desc && <p class="text-yin-6 dark:text-yin-4">{desc}</p>}

    {
        date && (
            <p class="text-base text-yin-6 dark:text-yin-4 flex gap-1 items-baseline">
                <i class="fa-solid fa-calendar-days" />
                <Date date={date} />
            </p>
        )
    }
</div>
