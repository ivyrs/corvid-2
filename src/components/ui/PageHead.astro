---
import { Icon } from "astro-icon/components";
import { iconName } from "~/lib/utils";
import Date from "~/components/ui/Date.astro";
import Breadcrumbs from "~/components/ui/Breadcrumbs.astro";

interface Props {
	title?: string;
	desc?: string;
	date?: Date | string;
	icon?: string;
	publish?: boolean;
}

const { title, desc, date, icon, publish } = Astro.props;
---

<div class="mb-2 flex flex-col gap-px">
	<h2 class="text-2xl font-bold flex items-center gap-2">
		{icon && <Icon name={iconName(icon)} />}
		<Breadcrumbs title={title} />
	</h2>
	<div class="flex gap-2 text-yin-6 dark:text-yin-4">
		{desc && <p>{desc}</p>}
		{desc && date && <span>·</span>}
		{
			date && (
				<p class="mt-0.5 text-base flex gap-1 items-baseline">
					<Icon name={iconName("fa-solid fa-calendar-days")} />
					<Date date={date} />
				</p>
			)
		}
	</div>
</div>
