---
import Date from "~/components/Date.astro";

interface Props {
    title: string;
    desc?: string;
    date?: Date | string;
    back?: string;
    icon?: string;
    prefix?: string;
}

const { title, desc, date, back, icon, prefix } = Astro.props;
---

<div class="mb-2 flex flex-col">
    {
        back && (
            <a href={back} class="link mb-1">
                {`<- back to ${back}`}
            </a>
        )
    }
    <h2 class="text-2xl font-bold">
        {icon && <i class={icon} />}

        <span>
            {
                prefix && (
                    <span class="text-yin-6 dark:text-yin-4">{prefix}</span>
                )
            }{title}
        </span>
    </h2>

    {desc && <p class="text-yin-6 dark:text-yin-4">{desc}</p>}

    {
        date && (
            <p class="text-base text-yin-6 dark:text-yin-4 flex gap-1 items-baseline">
                <i class="fa-solid fa-calendar-days" />
                <Date date={date} />
            </p>
        )
    }
</div>
