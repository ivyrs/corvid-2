---
import Icon from "~/components/ui/Icon.astro";
import DateWithIcon from "~/components/ui/DateWithIcon.astro";
import Breadcrumbs from "~/components/ui/Breadcrumbs.astro";

interface Props {
	title?: string;
	desc?: string;
	date?: Date | string;
	icon?: string;
	publish?: boolean;
}

const { title, desc, date, icon, publish } = Astro.props;
---

<div class="mb-2 flex flex-col gap-px">
	<h2 class="text-2xl font-bold flex items-center gap-2">
		{icon && <Icon name={icon} />}
		<Breadcrumbs title={title} />
	</h2>
	<div class="flex gap-2 text-yin-7 dark:text-yin-3">
		{desc && <p>{desc}</p>}
		{desc && date && <span>·</span>}
		{date && <DateWithIcon date={date} />}
	</div>
</div>
