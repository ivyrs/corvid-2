---
import { themeClasses, type Theme } from "~/lib/sectionThemes";

export interface Props {
	title?: string;
	xstyle?: string;
	theme?: Theme;
}

const {
	title,
	xstyle,
	theme = "yin",
} = Astro.props;

const colours = themeClasses[theme];
---

<div
	class:list={[
		"border-l pl-4 ml-4 w-fit",
		colours.border,
		xstyle,
	]}
>
	{title && <span class="text-base block mt-0.5">{title}</span>}
	<slot />
</div>
