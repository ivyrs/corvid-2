---
const { class: className } = Astro.props;

const classes = [
  "text-lg",
  "prose",
  "dark:prose-invert",
  "prose-headings:mt-3",
  "prose-p:my-2",
  "prose-headings:mb-2",
  "prose-headings:text-yin",
  "dark:prose-headings:text-yang",
  "prose-p:mt-0.5",
  "prose-p:text-yin",
  "dark:prose-p:text-yang",
  "prose-a:text-purple-7",
  "dark:prose-a:text-purple-2",
  "prose-a:decoration-dashed",
  "prose-li:text-yin",
  "dark:prose-li:text-yang",
  "prose-ul:my-2",
  "prose-ol:my-2",
  "prose-li:my-0.5",
  "marker:text-purple-7",
  "dark:marker:text-purple-2",
  "prose-a:underline-offset-6",
  "prose-hr:my-4",
];
---

<div
  class:list={[classes, className]}
>
    <slot />
</div>
