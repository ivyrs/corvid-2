---
import { Icon } from "astro-icon/components";
const { href, relme, xstyle, icon = "fa6-solid:arrow-right" } = Astro.props;
---

<a
	class:list={["flex items-center gap-1 my-1", xstyle]}
	rel={relme && "me"}
	href={href}
>
	<!-- <i class={icon + " text-xl text-red-7 dark:text-pink-4"}></i> -->
	<Icon name={icon} class={"text-xl text-red-7 dark:text-pink-4"} />
	<span class="link ml-1"><slot /></span>
</a>
