---
import Icon from "~/components/ui/Icon.astro";
import Date from "./Date.astro";

interface Props {
  date: Date | string;
  showTime?: boolean;
  icon?: string;
}
const { date, showTime, icon } = Astro.props;
---

<div class="flex items-center gap-2 text-yin-7 dark:text-yin-3 text-base font-mono">
    <Icon name={icon || "fa-solid fa-calendar-days"} />
    <Date date={date} showTime={showTime} />
</div>
