---
interface Props {
	href: string;
	relme?: boolean;
	xstyle?: string;
	icon?: string;
}

import Icon from "~/components/ui/Icon.astro";
const { href, relme, xstyle, icon = "fa7-solid:arrow-right" } = Astro.props;
---

<a
	class:list={["flex items-center gap-1 my-2 no-underline", xstyle]}
	rel={relme ? "me" : ""}
	href={href || "#"}
>
	<Icon name={icon} class={"text-xl text-red-7 dark:text-purple-2 mt-1"} />
	<span class="link ml-1"><slot /></span>
</a>
