---
interface Props {
	href: string;
	relme?: boolean;
	xstyle?: string;
	icon?: string;
}

import Icon from "~/components/ui/Icon.astro";
const { href, relme, xstyle, icon = "fa7-solid:arrow-right" } = Astro.props;

// MDX paragraph-wraps slot children written on their own line (e.g. a
// multi-line <Link>), which breaks the inline underline/alignment below.
// Strip that wrapper so the DOM is the same regardless of formatting.
let label = (await Astro.slots.render("default")).trim();
const wrapped = label.match(/^<p>([\s\S]*)<\/p>$/);
if (wrapped) label = wrapped[1].trim();
---

<a
	class:list={["flex items-center gap-1 my-2 no-underline", xstyle]}
	rel={relme ? "me" : ""}
	href={href || "#"}
>
	<Icon name={icon} class={"text-xl text-[var(--section-accent)] mt-1"} />
	<span class="link ml-1" set:html={label} />
</a>
