---
import { getBlogPosts } from "~/lib/blog";
import type { Theme } from "~/lib/sectionThemes";
import Post from "./BlogPost.astro";

interface Props {
  tag?: string;
  theme?: Theme;
}

const { tag, theme } = Astro.props;
const posts = await getBlogPosts(tag);
---

<ul class="flex flex-col gap-2">
  {
    posts.map((i) => {
      return <Post i={i} theme={theme} />;
    })
  }
</ul>
