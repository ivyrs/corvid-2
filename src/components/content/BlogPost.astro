---
import Item from "~/components/ui/Box.astro";
import Link from "~/components/ui/Link.astro";
import BlogTags from "./BlogTags.astro";
import DateWithIcon from "~/components/ui/DateWithIcon.astro";

const { i } = Astro.props;
const data = i.data;
---

<li>
  <Item>
    <Link icon={data.icon} href={`/blog/${i.id}`}>
      {data.title}
    </Link>

    <span class="flex flex-col gap-0.5 pl-4 border-l-1 border-l-yin-3 text-base text-yin-7 dark:text-yin-3">
      <DateWithIcon date={data.date} />
      <span class="">{data.desc}</span>
    </span>
    
    {data.tags && <BlogTags tags={data.tags} />}
  </Item>
</li>
