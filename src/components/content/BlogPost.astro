---
import Item from "~/components/ui/Box.astro";
import BlogTags from "./BlogTags.astro";
import Date from "~/components/ui/Date.astro";
import { themeClasses, type Theme } from "~/lib/sectionThemes";

interface Props {
	i: any;
	theme?: Theme;
}

const { i, theme } = Astro.props;
const data = i.data;
---

<li>
<Item theme="yin">
	<a
		href={`/blog/${i.id}`}
		class:list={theme
			? [
				"underline decoration-dashed underline-offset-4",
				themeClasses[theme].heading,
			]
			: "link"}
	>
		{data.title}
	</a>

	<div class="text-yin-7 dark:text-yin-3">
		<Date date={data.date} />
	</div>

	{data.desc && (
		<p class="text-base">
			{data.desc}
		</p>
	)}

	{data.tags && <BlogTags tags={data.tags} />}
</Item>
</li>
