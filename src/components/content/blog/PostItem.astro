---
import Item from "~/components/Item.astro";
import Link from "~/components/link.astro";
import Date from "~/components/Date.astro";

const { i } = Astro.props;
const data = i.data;
---

<li>
	<Item>
		<p class="flex gap-16">
			<Link icon="fa6-solid:hashtag" href={`/blog/${i.id}`}>
				{data.title}
			</Link>
		</p>
		<p class="text-yin-7 dark:text-yin-3 flex flex-col text-base">
			<span class="flex gap-1">
				<i class="fa-solid fa-calendar-days pt-1"></i><Date date={data.date} />
			</span>
			<span>{data.tldr}</span>
			<div class="flex gap-4 mt-2 text-sm">
				{
					data.tags &&
						data.tags.map((i: string) => {
							return (
								<span class="bg-red-7 text-yang dark:bg-pink-4 dark:text-yin px-2 py-0.5 rounded-sm">
									#{i}
								</span>
							);
						})
				}
			</div>
		</p>
	</Item>
</li>
