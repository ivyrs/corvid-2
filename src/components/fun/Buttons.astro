---
import { Image } from "astro:assets";
import others from "~/data/others.json";
---

<div class="grid grid-cols-[repeat(5,max-content)] gap-2">
	{
		others.buttons.map((i) => {
			return (
				<a href={"https://" + i.link} target="_blank">
					<Image
						style={"image-rendering: pixelated;"}
						loading={"eager"}
						src={i.image}
						width={88}
						height={31}
						alt={i.alt || i.link}
					/>
				</a>
			);
		})
	}
</div>
