---
import { Icon } from "astro-icon/components";
const { href, relme, xstyle, icon = "fa6-solid:arrow-right" } = Astro.props;

function iconName() {
    if (icon.startsWith("fa6-")) return icon;
    if (icon.startsWith("fa-")) { // check for fa css classes
       let s = icon.split(/[^a-z]+/g);
       return `fa6-${s[1]}:${s[3]}`
    }
}
---

<a
	class:list={["flex items-center gap-1 my-1 no-underline", xstyle]}
	rel={relme && "me"}
	href={href || "#"}
>
	<Icon name={iconName()} class={"text-xl text-red-7 dark:text-pink-4 mt-0.5"} />
	<span class="link ml-1"><slot /></span>
</a>
