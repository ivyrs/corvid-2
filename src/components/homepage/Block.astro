---
import { themeClasses, type Theme } from "~/lib/sectionThemes";

interface BlockLink {
	href: string;
	text?: string;
}

interface Props {
	title: string;
	theme?: Theme;
	links?: BlockLink[];
}

const { title, theme = "yin", links } = Astro.props;
const colours = themeClasses[theme];
---

<section
	class:list={[
		"not-prose w-full",
		colours.links,
		colours.accent,
	]}
>
	<h2 class={colours.heading}>{title}</h2>
	<hr class:list={["mt-1 mb-2 border-dashed", colours.border]} />

	<slot />

{links && (
	<div class="mt-4 flex flex-wrap gap-x-4">
		{links.map(({ href, text }) => (
			<a href={href}>
				→ {text ?? href}
			</a>
		))}
	</div>
)}</section>
