---
import { themeClasses, type Theme } from "~/lib/sectionThemes";

interface Props {
	title: string;
	theme?: Theme;
	link?: string;
	linkText?: string;
}

const { title, theme = "yin", link, linkText } = Astro.props;
const colours = themeClasses[theme];
---

<section
	class:list={[
		"not-prose w-full",
		colours.links,
		colours.accent,
	]}
>
	<h2 class={colours.heading}>{title}</h2>
	<hr class:list={["mt-1 mb-2 border-dashed", colours.border]} />

	<slot />

	{link && (
		<a href={link} class="mt-4 block">
			→ {linkText || link}
		</a>
	)}
</section>
