---
import { site } from "~/site.config";
import ThemeToggle from "~/components/layout/ThemeToggle.astro";

const nav = ["about", "now", "blog", "contact", "etc"];
---

<header class="w-fit sm:flex gap-4 mb-4">
	<a href="/" class="block w-fit">
		<p class="text-purple-7 dark:text-purple-2 pt-1">
			{`${site.title}`}
		</p>
	</a>
	<nav class="flex flex-row gap-4 pt-1 first:pl-8">
		{
			nav.map((i) => {
				return (
					<a class="text-purple-7 dark:text-purple-2" href={"/" + i}>
						{i}
					</a>
				);
			})
		}
		<ThemeToggle />
	</nav>
</header>
