---
import Icon from "~/components/ui/Icon.astro";
import DateWithIcon from "~/components/ui/DateWithIcon.astro";
import Breadcrumbs from "~/components/layout/Breadcrumbs.astro";

interface Props {
	title?: string;
	desc?: string;
	date?: Date | string;
	icon?: string;
	publish?: boolean;
	path?: string;
}

const { title, desc, date, icon, publish, path } = Astro.props;
---

<div class="mb-2 flex flex-col gap-px">
	<h2 class="text-xl font-bold flex items-center gap-2">
		{icon && <Icon name={icon} />}
		<Breadcrumbs title={title} path={path} />
	</h2>
<div class="text-yin-7 dark:text-yin-3">
	{desc && <p>{desc}</p>}
	{date && (
		<div class="mt-1 whitespace-nowrap">
			<DateWithIcon date={date} />
		</div>
	)}
</div>
</div>
