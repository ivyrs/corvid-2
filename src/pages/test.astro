---
import Base from "~/layouts/Base.astro";
import Discord from "~/components/external/discord.svelte"
import { getPresence } from "~/lib/external/lanyard";
const data = await getPresence("295975431058751498");
---

<Base showHeader={false} showFooter={false}>
    {data.discord_user.username} is {data.discord_status} <br>
    status: {data.activities[0].state}
    <Discord />
</Base>
