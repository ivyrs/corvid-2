---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { iconName } from "~/lib/utils";
import Page from "~/layouts/Page.astro";

const entries = await getCollection("pages");
const sorted = entries
  .filter((i) => i.data.collection)
  .sort((a, b) => {
    const titleA = a.data.title || a.id;
    const titleB = b.data.title || b.id;
    return titleA.localeCompare(titleB);
  });
---

<Page
  title="collections"
  icon="fa-solid fa-boxes-stacked"
>
	<ul class="fa-ul flex flex-col gap-1 text-lg">
    {
      sorted.map((i) => {
        return (
          <li>
            <span class="fa-li">
              <Icon name={iconName(i.data.icon)} />
            </span>
            <a
              class="link"
              href={`/${i.id}`}
            >{`${i.data.title || "" + i.id}`}</a>{" "}
            {i.data.desc && `- ${i.data.desc}`}
          </li>
        );
      })
    }
  </ul>
</Page>
