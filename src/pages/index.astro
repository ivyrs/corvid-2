---
import { author } from "~/site.config";
import Base from "../layouts/Base.astro";
import Link from "~/components/ui/link.astro";
---

<Base>
	<main class="pl-0 flex flex-col gap-2" id="content">
		<p>
			Hey! Welcome to my site, I'm {author.name}.
		</p>
		<p>
			I'm a <mark>CS student</mark> from the
			<mark>North of England</mark>!
			<br />

			When I'm not in front of a computer, I like to
			<mark>take photos</mark>, <br />
			<mark>collect stationary</mark>, and <mark>make music</mark>.
		</p>
		<p class="mt-2">
			this site's kind of a mess right now, but feel free to look around.
		</p>
		<Link href="//codeberg.org/ivyrs" icon="omg-icon omg-codeberg">
			codeberg
		</Link>
	</main>
</Base>
