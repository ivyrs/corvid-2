---
import Base from "~/layouts/Base.astro";

import About from "~/components/homepage/About.astro";
import Status from "~/components/homepage/Status.astro";
import Blog from "~/components/homepage/Blog.astro";
import Now from "~/components/homepage/Now.astro";
import OtherSites from "~/components/homepage/OtherSites.astro";
import Etc from "~/components/homepage/Etc.astro";
---

<Base showHeader={false}>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-y-8 md:gap-x-8">
		<!-- intro / about -->
		<div class="md:col-span-2">
			<About />
		</div>

		<!-- state -->
		<div class="md:col-span-1">
			<Status />
		</div>

		<!-- now -->
		<div class="md:col-span-1">
			<Now />
		</div>

		<!-- blog -->
		<div class="md:col-span-2">
			<Blog />
		</div>
	
		<div class="md:col-span-2">
			<OtherSites />
		</div>

		<div class="md:col-span-1">
			<Etc />
		</div>
	</div>
</Base>
