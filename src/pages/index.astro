---
import { author } from "~/site.config";
import Base from "../layouts/Base.astro";
import Link from "~/components/ui/link.astro";
---

<Base>
	<main class="pl-0 flex flex-col gap-2" id="content">
		<p>
			
		</p>
		<p>
			Hey! Welcome to my site, I'm {author.name}.
		</p>
		<p>
			I'm a <mark>CS student</mark> from the
			<mark>North of England</mark>!
			<br />

			When I'm not in front of a computer, I like to
			<mark>take photos</mark>, <br />
			<mark>collect stationary</mark>, and <mark>make music</mark>.
		</p>
		<p class="mt-2">
			this site's kind of a mess right now, but feel free to look around.
		</p>
		<div class="font-mono sm:flex flex-col gap-2">
			<p>--- START IVY'S LINKS ---</p>
			<div class="sm:flex gap-16">
				<Link href="//git.lovecomputer.net/ivy" icon="fa6-solid:code-branch">
					LCgit
				</Link>
				<Link href="//codeberg.org/ivyrs" icon="devicon-plain:codeberg">
					Codeberg (@ivyrs)
				</Link>
				<Link href="//github.com/ivyturner" icon="fa7-brands:github">
					GitHub (@ivyturner)	
				</Link>
			</div>
			<div class="sm:flex gap-16">
				<Link href="//fedi.ivy.rs/i">
					@i@fedi.ivy.rs (personal)
				</Link>
				<Link href="//social.lol/@ivy">
					@ivy@social.lol (work)
				</Link>
			</div>
			<Link href="mailto:ivy@ivy.rs" icon="fa6-solid:envelope">ivy@ivy.rs</Link>
			<p>--- END IVY'S LINKS ---</p>
		</div>
	</main>
</Base>
