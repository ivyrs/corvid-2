---
import Prose from "~/components/ui/prose.astro";
import Base from "../layouts/Base.astro";
import { Content as Bio } from "~/content/home/bio.md";
import Link from "~/components/ui/link.astro";
import Item from "~/components/ui/Item.astro";
import Blog from "~/components/home/blog.astro";
// export const prerender = false;
---

<Base>
  <main class="pl-0">
    <p class="text-2xl font-bold mb-2">Welcome to my site!</p>
    <Prose><Bio /></Prose>
    <Link href="https://ivy.pika.page">My blog (for now)</Link>

    <div class="sm:flex sm:flex-col md:grid md:grid-cols-2 md:grid-rows-2 gap-4">
      <div><Item><Blog /></Item></div>
      <div><Item>2</Item></div>
      <div class="md:col-start-1 md:row-start-2"><Item>3</Item></div>
      <div class="md:col-start-2 md:row-start-2"><Item>4</Item></div>
    </div>
  </main>
</Base>
