---
import PostList from "~/components/content/BlogList.astro";
import Page from "~/layouts/Page.astro";
import { getAllTags } from "~/lib/blog";
import { sectionThemes } from "~/lib/sectionThemes";

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { tag },
		props: { tag },
	}));
};

const { tag } = Astro.props;
---

<Page title={tag} icon="fa-solid fa-tag" theme={sectionThemes.blog}>
	<PostList tag={tag} theme={sectionThemes.blog} />
</Page>
