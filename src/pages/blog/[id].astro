---
import Icon from "~/components/ui/Icon.astro";
import Page from "~/layouts/Page.astro";
import Prose from "~/components/ui/Prose.astro";
import Quote from "~/components/ui/Quote.astro";
import BlogTags from "~/components/content/BlogTags.astro";
import TOC from "~/components/ui/TableOfContents.astro";

import { getBlogPosts } from "~/lib/blog";
import { render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
---

<Page title={d.title} desc={d.desc} date={d.date} icon={d.icon} publish={d.publish}>
	{
		d.cw && (
			<p class="my-2 text-yin-7 dark:text-yin-3 flex gap-2">
				<Icon name="fa-solid fa-burst" />
				<span>cw: {d.cw}</span>
			</p>
		)
	}
	
	<section class="lg:grid lg:grid-cols-[minmax(0,65ch)_16rem] lg:gap-12 lg:items-start" >
		<Prose class="!prose-headings:mt-12 !prose-headings:mb-8 lg:pr-[19rem]">
			<Content components={{ blockquote: Quote }} />
		</Prose>

		{headings.length > 1 && <TOC headings={headings} />}
	</section>

	{d.tags && <BlogTags tags={d.tags} />}
</Page>
