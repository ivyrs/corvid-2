const extra = [
  {
    id: "blank",
    data: {
      title: "",
      icon: "fa-solid fa-square",
      desc: "▓▓▓▓▓▓▓▓▓▓",
      hide: false,
    },
  }
];

const entries = await getCollection("pages");
const sorted = [...entries, ...extra]
  .filter((i) => !i.data.hide)
  .sort((a, b) => {
    const titleA = a.data.title || a.id;
    const titleB = b.data.title || b.id;
    return titleA.localeCompare(titleB);
  });
---

<Page title="More" desc="all the pages not linked to in the header">
  <ul class="fa-ul">
    {
      sorted.map((i) => {
        return (
          <li>
            <i class={`fa-li ${i.data.icon}`} />
            <a
              class="link"
              href={`/${i.id}`}
            >{`${i.data.title || "/" + i.id}`}</a>{" "}
            {i.data.desc && `- ${i.data.desc}`}
          </li>
        );
      })
    }
  </ul>
</Page>
