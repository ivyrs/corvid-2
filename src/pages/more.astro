---
import Page from "../layouts/Page.astro";

const pages = [
  {
    name: "blank",
    icon: "fa-solid fa-square",
    desc: "▓▓▓▓▓▓▓▓▓▓",
  },
  {
    name: "ai",
    icon: "fa-solid fa-robot",
    desc: "how i use ai",
  },
  {
    name: "nomenclature",
    icon: "fa-solid fa-signature",
    desc: "how i'd like to be referred to"
  },
  {
    name: "accounts",
    icon: "fa-solid fa-globe",
    desc: "places i exist on the internet"
  },
  {
    name: "hills",
    icon: "fa-solid fa-mountain",
    desc: "hills i will die on"
  }
];

pages.sort((a, b) => a.name.localeCompare(b.name));
---

<Page title="More" desc="all the pages not linked to in the header">
  <ul class="fa-ul">
    {
      pages.map((i) => {
        return (
          <li>
            <i class={`fa-li ${i.icon}`} />
            <a class="link" href={`/${i.name}`}>{`/${i.name}`}</a> - {i.desc}
          </li>
        );
      })
    }
  </ul>
</Page>
