---
import Page from "~/layouts/Page.astro";
import { getBlogPosts } from "~/lib/blog";
import { render } from "astro:content";
import Prose from "~/components/ui/Prose.astro";

const posts = await getBlogPosts("now");
const latest = posts[0];

const { Content } = await render(latest);
const data = latest.data;
---

<Page title={"now"} desc="a page that tells you what this person* is focused on at this point in their life" date={data.date} icon={"fa-solid fa-calendar"}>
    <Prose>
        <Content />
    </Prose>
    <p class="text-base text-yin-6 dark:text-yin-4">
        this page is auto generated from the latest blog post with the #now tag.
        you can find it <a class="link" href=`/blog/${latest.id}`>here</a>
    </p>
</Page>
