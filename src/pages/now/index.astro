---
import Page from "~/layouts/Page.astro";
import Prose from "~/components/ui/Prose.astro";
import { render } from "astro:content";
import CDate from "~/components/ui/Date.astro";
import { getNowPosts } from "~/lib/now";

const posts = await getNowPosts()

const rendered = await Promise.all(
	posts.map(async (post) => ({
		post,
		Content: (await render(post)).Content,
	})),
);
---

<Page
	title="now"
	desc="a page that tells you what this person* is focused on at this point in their life"
	icon="fa-solid fa-calendar"
>
	{
		rendered.map(({ post, Content }) => (
			<article id={post.id} class="mb-4">
				<h3 class="text-purple-7 dark:text-purple-2 font-bold mb-1">
					<CDate date={post.id} />
				</h3>
				<Prose>
					<Content />
				</Prose>
			</article>
		))
	}
</Page>
