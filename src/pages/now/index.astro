---
import Page from "~/layouts/Page.astro";
import Prose from "~/components/ui/Prose.astro";
import { render } from "astro:content";
import CDate from "~/components/ui/Date.astro";
import { getNowPosts } from "~/lib/now";
import { sectionThemes, themeClasses } from "~/lib/sectionThemes";

const posts = await getNowPosts();
const theme = sectionThemes.now;
const colours = themeClasses[theme];

const [latest, ...older] = await Promise.all(
	posts.map(async (post) => ({
		post,
		Content: (await render(post)).Content,
	})),
);
---

<Page
	title="now"
	desc="what i'm focused on"
	icon="fa-solid fa-calendar"
	theme={theme}
	feedBase="/now/feed"
>
	{latest && (
		<article id={latest.post.id} class="mb-8">
			<h2 class:list={["mb-1", colours.heading]}>
				right now
				<span class="ml-2 font-normal text-yin-7 dark:text-yin-3">
					<CDate date={latest.post.id} />
				</span>
			</h2>

			<Prose>
				<latest.Content />
			</Prose>
		</article>
	)}

	{older.length > 0 && (
		<section>
			<h2 class="mb-4 text-yin-7 dark:text-yin-3">
				previously
			</h2>

			<div class="space-y-6">
				{older.map(({ post, Content }) => (
					<article id={post.id}>
						<h3 class="mb-1 text-yin-7 dark:text-yin-3">
							<CDate date={post.id} />
						</h3>

						<Prose>
							<Content />
						</Prose>
					</article>
				))}
			</div>
		</section>
	)}
</Page>
