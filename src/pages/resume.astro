---
import fs from "node:fs";
import path from "node:path";
import Layout from "~/layouts/Page.astro";
import Prose from "~/components/ui/Prose.astro";

const html = fs.readFileSync(path.resolve(process.cwd(), "resume/resume.html"), "utf-8");
const body = html.match(/<body>([\s\S]*)<\/body>/)?.[1] ?? "";
---

<Layout title="resume" desc="written in typst" icon="fa-solid fa-file-lines" showHeader={false} showPageHeader={false} showFooter={false}>
	<Prose class="resume-content" set:html={body} />
</Layout>

<style>
	.resume-content {
		max-width: 48rem;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.resume-content :global(p:first-child) {
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
		line-height: 1.45;
	}

	.resume-content :global(p:first-child strong) {
		display: inline-block;
		margin-bottom: 0.25rem;
		font-size: 1.8rem;
		font-weight: 700;
		line-height: 1.15;
	}

	.resume-content :global(h3) {
		margin: 1.5rem 0 0.65rem;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.25;
	}

	.resume-content :global(h4) {
		margin: 0.85rem 0 0.1rem;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.resume-content :global(h4 + p) {
		margin: 0 0 0.35rem;
		font-size: 0.85rem;
		line-height: 1.35;
	}

	.resume-content :global(h4 + p em) {
		font-style: normal;
	}

	.resume-content :global(ul) {
		margin: 0.25rem 0 0.75rem;
		padding-left: 1.25rem;
	}

	.resume-content :global(li) {
		margin: 0.15rem 0;
		font-size: 0.9rem;
		line-height: 1.45;
	}

	@media print {
		.resume-content {
			font-size: 10pt;
		}
	}
</style>
