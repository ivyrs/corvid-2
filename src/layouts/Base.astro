---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Metadata from "~/components/Metadata.astro";
import Footer from "~/components/Footer.astro";

const { title, desc, showHeader = true, showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<Metadata title={title} desc={desc} />

	<body
		class="bg-yang text-yin dark:bg-yin dark:text-yang sm:p-8 md:px-16 text-lg text-pretty font"
	>
		<a href="#content" class="hidden selection:inline">skip to content</a>
		{showHeader && <Header />}

		<slot />

		{showFooter && <Footer />}
	</body>
</html>
