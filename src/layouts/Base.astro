---
/** biome-ignore-all lint/correctness/noUnusedImports: Astro */
/** biome-ignore-all lint/correctness/noUnusedVariables: Astro */

import "~/styles/global.css";
import Header from "~/components/ui/Header.astro";
import Metadata from "~/components/util/Metadata.astro";
import Footer from "~/components/ui/Footer.astro";

const { title, desc, showHeader = true, showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <Metadata title={title} desc={desc} />

  <body class="bg-yang text-yin dark:bg-yin dark:text-yang p-8">
    {showHeader && <Header />}

    <slot />
    
    {showFooter && <Footer />}
  </body>
</html>
