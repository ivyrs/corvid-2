---
import Base from "./Base.astro";
import PageHead from "~/components/ui/PageHead.astro";

const {
    showPageHeader = true,
    showHeader,
    title,
    desc,
    date,
    icon,
    back,
    prefix,
    prefixMeta,
} = Astro.props;

const t = prefixMeta ? prefix + title : title;
---

<Base title={t} desc={desc} showHeader={showHeader}>
    <main
        class="ml-4 pb-4 pt-3 px-4 border-l-1 border-dashed border-l-red-7 dark:border-l-pink-4"
    >
        {
            showPageHeader && (
                <PageHead
                    title={title}
                    desc={desc}
                    date={date}
                    back={back}
                    icon={icon}
                    prefix={prefix}
                />
            )
        }
        <slot />
    </main>
</Base>
