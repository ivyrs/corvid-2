---
import Breadcrumbs from "~/components/layout/Breadcrumbs.astro";
import Base from "./Base.astro";
import PageHead from "~/components/layout/PageHead.astro";
import { themeClasses, themeForPath, type Theme } from "~/lib/sectionThemes";

const {
    showPageHeader = true,
    showHeader,
    title,
    desc,
    feedBase,
    date,
    icon,
    path,
} = Astro.props;
const theme = (Astro.props.theme as Theme | undefined) ?? themeForPath(Astro.url.pathname);
const colours = themeClasses[theme];
---

<Base title={title} desc={desc} feedBase={feedBase} showHeader={showHeader}>
    <main
        class:list={[
            "ml-2 pl-4 py-2 border-l-1 border-dashed",
            colours.border,
            colours.links,
			colours.accent,
        ]}
    >
        {
            showPageHeader && (
                <PageHead
                    title={title}
                    desc={desc}
                    date={date}
                    icon={icon}
                    path={path}
                    headingClass={colours.heading}
                />
            )
        }
        <slot />
    </main>
</Base>
