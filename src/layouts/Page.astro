---
import Breadcrumbs from "~/components/ui/Breadcrumbs.astro";
import Base from "./Base.astro";
import PageHead from "~/components/ui/PageHead.astro";

const {
    showPageHeader = true,
    showHeader,
    title,
    desc,
    date,
    icon,
    path,
} = Astro.props;
---

<Base title={title} desc={desc} showHeader={showHeader}>
    <main
        class="ml-4 pb-4 pt-3 px-4 border-l-1 border-dashed border-l-purple-7 dark:border-l-purple-2"
    >
        {
            showPageHeader && (
                <PageHead
                    title={title}
                    desc={desc}
                    date={date}
                    icon={icon}
                    path={path}
                />
            )
        }
        <slot />
    </main>
</Base>
